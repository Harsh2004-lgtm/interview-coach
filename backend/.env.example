# Server Port
PORT=5000

# Primary Google AI Studio API Key
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Specific Gemma / Google AI Model preference
# Default fallback sequence: gemma-4-31b-it -> gemma-4-26b-a4b-it -> gemini-3.5-flash-lite
GEMMA_MODEL=gemini-3.5-flash-lite
