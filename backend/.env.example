# Server Port
PORT=5000

# Primary Gemma Provider: Google AI Studio
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemma Model choice (default: gemma-2-9b-it, or gemma-2-27b-it)
GEMMA_MODEL=gemma-2-9b-it

# Optional Alternative Provider: Groq (ultra fast Gemma 2 hosting)
# Get a key at: https://console.groq.com/
GROQ_API_KEY=

# Optional Local Gemma via Ollama (e.g. http://localhost:11434)
OLLAMA_BASE_URL=
